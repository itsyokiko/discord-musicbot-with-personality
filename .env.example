# Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token

# Re:Link / OpenAI-compatible LLM Gateway
RELINK_API_KEY=your_relink_api_key
RELINK_BASE_URL=https://api.relink-gateway.biz.id/v1
RELINK_MODEL=deepseek-v4-pro

# TinyFish Search (for deterministic YouTube music search)
TINYFISH_API_KEY=your_tinyfish_api_key

# Web Dashboard Port
PORT=3000

# Optional Configurations
# GIPHY_API_KEY=your_giphy_api_key
# GIF_CHANCE=0.3
# GENERAL_CHANNEL_ID=
# YOUTUBE_COOKIES=
# ALONE_TIMEOUT_MS=60000
